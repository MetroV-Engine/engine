{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "all",
      "displayName": "Everything to run the project: executables and editor, no tests (the default)",
      "inherits": "base",
      "cacheVariables": {
        "ENGINE_BUILD_GUI": "ON"
      }
    },
    {
      "name": "tests",
      "displayName": "Everything, plus the unit tests (what CI builds)",
      "inherits": "all",
      "cacheVariables": {
        "ENGINE_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "runtime",
      "displayName": "Executables only: no editor, no tests",
      "inherits": "base",
      "cacheVariables": {
        "ENGINE_BUILD_GUI": "OFF"
      }
    },
    {
      "name": "coverage",
      "displayName": "Everything plus the unit tests, with code coverage (GCC / Clang) (renderer off until its tests exist)",
      "inherits": "tests",
      "cacheVariables": {
        "ENGINE_ENABLE_COVERAGE": "ON",
        "ENGINE_BUILD_RENDERER": "OFF"
      }
    },
    {
      "name": "bgfx",
      "displayName": "Everything to run the project, with the bgfx backend (slow first build: fetches bgfx and its shader compiler)",
      "inherits": "all",
      "cacheVariables": {
        "ENGINE_RENDERER_BGFX": "ON"
      }
    },
    {
      "name": "bgfx-tests",
      "displayName": "Everything plus the unit tests, with the bgfx backend",
      "inherits": "tests",
      "cacheVariables": {
        "ENGINE_RENDERER_BGFX": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "all",
      "configurePreset": "all"
    },
    {
      "name": "tests",
      "configurePreset": "tests"
    },
    {
      "name": "runtime",
      "configurePreset": "runtime"
    },
    {
      "name": "coverage",
      "configurePreset": "coverage"
    },
    {
      "name": "bgfx",
      "configurePreset": "bgfx"
    },
    {
      "name": "bgfx-tests",
      "configurePreset": "bgfx-tests"
    }
  ],
  "testPresets": [
    {
      "name": "tests",
      "configurePreset": "tests",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "coverage",
      "configurePreset": "coverage",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "bgfx-tests",
      "configurePreset": "bgfx-tests",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
