{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "all",
      "displayName": "Everything to run the project: executables and editor, no tests (the default)",
      "inherits": "base",
      "cacheVariables": { "ENGINE_BUILD_GUI": "ON" }
    },
    {
      "name": "tests",
      "displayName": "Everything, plus the unit tests (what CI builds)",
      "inherits": "all",
      "cacheVariables": { "ENGINE_BUILD_TESTS": "ON" }
    },
    {
      "name": "runtime",
      "displayName": "Executables only: no editor, no tests",
      "inherits": "base",
      "cacheVariables": { "ENGINE_BUILD_GUI": "OFF" }
    },
    {
      "name": "coverage",
      "displayName": "Everything plus the unit tests, with code coverage (GCC / Clang)",
      "inherits": "tests",
      "cacheVariables": { "ENGINE_ENABLE_COVERAGE": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "all",      "configurePreset": "all" },
    { "name": "tests",    "configurePreset": "tests" },
    { "name": "runtime",  "configurePreset": "runtime" },
    { "name": "coverage", "configurePreset": "coverage" }
  ],
  "testPresets": [
    { "name": "tests",    "configurePreset": "tests",    "output": { "outputOnFailure": true } },
    { "name": "coverage", "configurePreset": "coverage", "output": { "outputOnFailure": true } }
  ]
}
